# Copy this file to .env and adjust the values.

# Port the server listens on
PORT=3000

# Max API requests per IP per minute
RATE_LIMIT_MAX=40

# How long resolved links are cached (seconds)
CACHE_TTL_SECONDS=600

# Minimum gap between calls to the upstream service (milliseconds)
UPSTREAM_MIN_INTERVAL_MS=1100

# Set when running behind a reverse proxy (Nginx, Cloudflare, etc.)
# so rate limiting sees the real visitor IP. Use a hop count such as 1, or "true".
# TRUST_PROXY=1

# Upstream resolver (default shown)
# TIKWM_API=https://www.tikwm.com
